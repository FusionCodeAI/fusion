{
  "name": "@theaungmyatmoe/fusion",
  "version": "0.3.0",
  "description": "Official TypeScript & WebAssembly SDK for Fusion AI Coding Assistant — pure-Rust engine with in-memory VFS, streaming turns, subagents, and xterm.js integration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js",
      "default": "./dist/wasm.js"
    },
    "./xterm": {
      "types": "./dist/xterm-adapter.d.ts",
      "import": "./dist/xterm-adapter.js",
      "default": "./dist/xterm-adapter.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && tsc",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js 2>/dev/null || true",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theaungmyatmoe/fusion.git",
    "directory": "sdk"
  },
  "keywords": [
    "fusion",
    "ai",
    "coding-assistant",
    "webassembly",
    "wasm",
    "agent",
    "llm",
    "claude",
    "gpt-4o",
    "deepseek",
    "xterm",
    "terminal",
    "virtual-filesystem",
    "subagents",
    "typescript"
  ],
  "author": "Aung Myat Moe",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/theaungmyatmoe/fusion/issues"
  },
  "homepage": "https://github.com/theaungmyatmoe/fusion#readme",
  "peerDependencies": {
    "@xterm/xterm": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@xterm/xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xterm/xterm": "^5.5.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
