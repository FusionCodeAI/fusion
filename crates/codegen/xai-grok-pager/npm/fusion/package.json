{
    "name": "@fusioncode/cli",
    "version": "0.1.0",
    "description": "Bring Fusion into your terminal",
    "license": "Apache-2.0",
    "bin": {
        "fusion": "bin/fusion"
    },
    "files": [
        "bin/"
    ],
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "cpu": [
        "arm64",
        "x64"
    ],
    "scripts": {
        "postinstall": "node bin/postinstall.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@iarna/toml": "^3.0.0"
    },
    "optionalDependencies": {
        "@fusioncode/cli-darwin-arm64": "0.1.0",
        "@fusioncode/cli-darwin-x64": "0.1.0",
        "@fusioncode/cli-linux-arm64": "0.1.0",
        "@fusioncode/cli-linux-x64": "0.1.0",
        "@fusioncode/cli-win32-arm64": "0.1.0",
        "@fusioncode/cli-win32-x64": "0.1.0"
    }
}
