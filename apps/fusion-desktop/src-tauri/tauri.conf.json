{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fusion-desktop",
  "version": "2.0.0",
  "identifier": "com.fusioncode.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fusion Agent",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "fusion"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
