{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fusion",
  "version": "2.0.0",
  "identifier": "fusioncode.app.fusion",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fusion Agent",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default permissions for Fusion Desktop",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "shell:default",
            "shell:allow-execute",
            "shell:allow-spawn"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/fusion"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
